# Unique secret seeds -> deterministic agent addresses. Change these!
ORCHESTRATOR_SEED=change-me-orchestrator-seed-phrase
WEATHER_SEED=change-me-weather-seed-phrase
PLACES_SEED=change-me-places-seed-phrase
BUDGET_SEED=change-me-budget-seed-phrase

# Fill AFTER first run (each agent prints its address on startup)
WEATHER_AGENT_ADDRESS=
PLACES_AGENT_ADDRESS=
BUDGET_AGENT_ADDRESS=

# Optional: ASI1 LLM for natural-language intent parsing (https://asi1.ai/developer)
# Without it the agent falls back to a built-in rule-based parser.
ASI1_API_KEY=
ASI1_MODEL=asi1
